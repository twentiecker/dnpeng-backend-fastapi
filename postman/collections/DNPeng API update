                "exec": [
                  "const isSuccessfulJson = pm.response.code === 200 &&\n    /application\\/json/i.test(pm.response.headers.get('Content-Type') || '');\n\nlet jsonData;\nif (isSuccessfulJson) {\n    try {\n        jsonData = pm.response.json();\n    } catch (error) {\n        console.warn('Successful response was not valid JSON; tokens were not updated.', error);\n    }\n}\n\nif (jsonData) {\n    if (typeof jsonData.access_token === 'string' && jsonData.access_token.trim() &&\n        typeof jsonData.refresh_token === 'string' && jsonData.refresh_token.trim()) {\n        pm.environment.set('access_token', jsonData.access_token);\n        pm.environment.set('refresh_token', jsonData.refresh_token);\n    }\n}\n\npm.test('Status code is 200', function () {\n    pm.response.to.have.status(200);\n});\n\npm.test('Response time is under 1000 ms', function () {\n    pm.expect(pm.response.responseTime).to.be.below(1000);\n});\n\npm.test('Content-Type is JSON', function () {\n    pm.expect(pm.response.headers.get('Content-Type') || '').to.match(/application\\/json/i);\n});\n\npm.test('Response contains required top-level fields', function () {\n    pm.expect(jsonData).to.be.an('object');\n    pm.expect(jsonData).to.have.all.keys('access_token', 'refresh_token', 'token_type', 'user');\n});\n\npm.test('Tokens are non-empty strings', function () {\n    pm.expect(jsonData).to.be.an('object');\n    pm.expect(jsonData.access_token).to.be.a('string').and.not.empty;\n    pm.expect(jsonData.access_token.trim()).to.not.equal('');\n    pm.expect(jsonData.refresh_token).to.be.a('string').and.not.empty;\n    pm.expect(jsonData.refresh_token.trim()).to.not.equal('');\n});\n\npm.test('Token type is bearer', function () {\n    pm.expect(jsonData).to.be.an('object');\n    pm.expect(jsonData.token_type).to.be.a('string');\n    pm.expect(jsonData.token_type.toLowerCase()).to.equal('bearer');\n});\n\npm.test('User contains required fields', function () {\n    pm.expect(jsonData).to.be.an('object');\n    pm.expect(jsonData.user).to.be.an('object');\n    pm.expect(jsonData.user).to.include.all.keys('id', 'name', 'email', 'role');\n});\n\npm.test('User email and role are correct', function () {\n    pm.expect(jsonData).to.be.an('object');\n    pm.expect(jsonData.user).to.be.an('object');\n    pm.expect(jsonData.user.email).to.equal('admin@admin.com');\n    pm.expect(jsonData.user.role).to.equal('admin');\n});"
