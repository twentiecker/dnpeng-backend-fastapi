ray.isArray(body)) return [];\n    const candidates = [body];\n    ['meta', 'metadata', 'pagination', 'params', 'query', 'request'].forEach(function (key) {\n        if (body[key] && typeof body[key] === 'object') candidates.push(body[key]);\n    });\n    if (body.data && typeof body.data === 'object' && !Array.isArray(body.data)) {\n        candidates.push(body.data);\n        ['meta', 'metadata', 'pagination', 'params', 'query', 'request'].forEach(function (key) {\n            if (body.data[key] && typeof body.data[key] === 'object') candidates.push(body.data[key]);\n        });\n    }\n    return candidates;\n}\n\nfunction findEchoedCode(body) {\n    const candidates = collectMetadata(body);\n    for (let index = 0; index < candidates.length; index += 1) {\n        if (hasOwn(candidates[index], 'kode')) return candidates[index].kode;\n    }\n    return undefined;\n}\n\nif ([200, 201].includes(statusCode)) {\n    pm.test('Status sukses adalah 200 atau 201', function () {\n        pm.expect(statusCode).to.be.oneOf([200, 201]);\n    });\n\n    if (isValidJson) {\n        const dataItems = findDataArray(jsonData);\n\n        pm.test('Kode pada metadata dan item data sesuai parameter request', function () {\n            collectMetadata(jsonData).forEach(function (candidate, index) {\n                assertMatchingCodes(candidate, 'metadata[' + index + ']');\n            });\n\n            if (Array.isArray(dataItems)) {\n                dataItems.forEach(function (item, index) {\n                    assertMatchingCodes(item, 'data[' + index + ']');\n                });\n            }\n        });\n\n        if (Array.isArray(dataItems) && dataItems.length === 0) {\n            pm.test('Kode tidak dikenal mengembalikan 200, data kosong, dan echo kode', function () {\n                pm.expect(statusCode).to.eql(200);\n                pm.expect(dataItems).to.be.an('array').that.is.empty;\n                pm.expect(findEchoedCode(jsonData), 'Kode request harus di-echo pada metadata/envelope')\n                    .to.not.eql(undefined);\n                pm.expect(String(findEchoedCode(jsonData))).to.eql(String(requestedKode));\n            });\n        }\n    }\n}\n\nif (statusCode === 401) {\n    pm.test('Skenario unauthorized mengembalikan 401 dan bukan 500', function () {\n        pm.expect(statusCode).to.eql(401);\n        pm.expect(statusCode).not.to.eql(500);\n    });\n}\n\nif ([400, 422].includes(statusCode)) {\n    pm.test('Parameter kosong/tidak valid mengembalikan 400 atau 422', function () {\n        pm.expect(statusCode).to.be.oneOf([400, 422]);\n    });\n\n    if (isValidJson) {\n        pm.test('Respons parameter tidak valid memiliki pesan error yang detail', function () {\n            const detail = jsonData && (\n                jsonData.detail || jsonData.message || jsonData.error || jsonData.errors ||\n                (jsonData.data && (jsonData.data.detail || jsonData.data.message || jsonData.data.error || jsonData.data.errors))\n            );\n            pm.expect(detail, 'detail/message/error/errors harus tersedia').to.exist;\n            if (typeof detail === 'string') {\n                pm.expect(detail.trim().length, 'Pesan error tidak boleh kosong').to.be.above(0);\n            } else {\n                pm.expect(detail, 'Detail error harus berisi informasi').to.satisfy(function (value) {\n                    return Array.isArray(value) ? value.length > 0 :\n                        value && typeof value === 'object' ? Object.keys(value).length > 0 : Boolean(value);\n                });\n            }\n        });\n    }\n}\n\npm.test('Server tidak mengembalikan internal error 500', function () {\n    pm.expect(statusCode).not.to.eql(500);\n});"
