                  "const requestedKode = pm.request.url.query.get(\"kode\");\nconst requestedStart = pm.request.url.query.get(\"start\");\nconst requestedEnd = pm.request.url.query.get(\"end\");\n\nfunction parseMonthlyPeriod(period) {\n    const match = /^(\\d{4})M(\\d{1,2})$/.exec(period || \"\");\n    pm.expect(match, `Valid monthly period: ${period}`).to.not.equal(null);\n    const year = Number(match[1]);\n    const month = Number(match[2]);\n    pm.expect(month, `Month in range for ${period}`).to.be.within(1, 12);\n    return { year, month };\n}\n\nconst startPeriod = parseMonthlyPeriod(requestedStart);\nconst endPeriod = parseMonthlyPeriod(requestedEnd);\nconst expectedPeriodCount =\n    (endPeriod.year - startPeriod.year) * 12 +\n    (endPeriod.month - startPeriod.month) + 1;\n\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response time is below 1000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(1000);\n});\n\npm.test(\"Content-Type is application/json\", function () {\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\n});\n\npm.test(\"Response body is valid JSON\", function () {\n    pm.response.to.be.json;\n});\n\npm.test(\"Response kode equals requested kode\", function () {\n    const json = pm.response.json();\n    pm.expect(json).to.have.property(\"kode\", requestedKode);\n});\n\npm.test(\"Response contains a data array\", function () {\n    const json = pm.response.json();\n    pm.expect(json).to.have.property(\"data\").that.is.an(\"array\");\n});"
